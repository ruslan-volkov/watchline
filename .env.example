EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# TMDB v4 read access token (Bearer). If absent, the app falls back to mock media data.
EXPO_PUBLIC_TMDB_ACCESS_TOKEN=
# PostHog project API key. Without it the analytics layer is a no-op, so the app
# runs unchanged for anyone who has not set up a project.
EXPO_PUBLIC_POSTHOG_KEY=
# Ingestion host. Defaults to the EU cloud; set the US one if your project lives there.
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
