# Secrets for the daily-digest Edge Function (local only — never commit the real .env).
# Push them to the deployed function with:
#   supabase secrets set --env-file supabase/functions/.env --project-ref <project-ref>

# TMDB v4 read access token (Bearer). Used to detect episodes airing today.
TMDB_ACCESS_TOKEN=

# Shared secret the pg_cron job sends in the x-cron-secret header to trigger the digest.
CRON_SECRET=
