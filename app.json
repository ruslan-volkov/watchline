{
  "expo": {
    "name": "Watchline",
    "slug": "Watchline",
    "version": "1.0.0",
    "scheme": "watchline",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rvolkov.watchline"
    },
    "android": {
      "package": "com.rvolkov.watchline",
      "adaptiveIcon": {
        "backgroundColor": "#7FA487",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#7FA487"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Watchline utilise tes photos pour choisir un avatar."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "resizeMode": "cover",
          "backgroundColor": "#EEF3EE",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#1E2A20"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
